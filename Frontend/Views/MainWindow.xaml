<Window x:Class="OCRDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OCRDesktop"
        xmlns:vm="clr-namespace:OCRDesktop.ViewModels"
        mc:Ignorable="d"
        Title="Extracció + Connexió ERP"
        Height="700"
        Width="1000"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Margin="40"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Archivos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                            LastChildFill="False"
                            Margin="0,0,0,40">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="OCR Intelligence"
                                    FontSize="32"
                                    FontWeight="ExtraBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,5,0,0">
                                <TextBlock Text="Directorio: "
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="12"/>
                                <TextBlock Text="{Binding DebugPath}"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                 DockPanel.Dock="Right">
                            <Button Content="Seleccionar Todos"
                                    Command="{Binding SelectAllCommand}"
                                    Padding="15,0"
                                    Margin="0,0,10,0"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource TextSecondaryBrush}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="Sincronizar"
                                    Command="{Binding RefreshCommand}"
                                    Padding="15,0"
                                    Margin="0,0,10,0"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource TextSecondaryBrush}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="PROCESAR"
                                    Command="{Binding ProcessCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="150"
                                    Height="50"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1"
                             VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModernCard}"
                                                BorderBrush="{StaticResource PrimaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="50"
                                                        Height="50"
                                                        CornerRadius="12"
                                                        Background="#1e293b"
                                                        Margin="0,0,20,0">
                                                    <TextBlock Text="✔"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="20"
                                                            Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="White"/>
                                                    <TextBlock Text="Extracción completada con éxito"
                                                            FontSize="12"
                                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                    <Button Content="Revisar"
                                                            Command="{Binding DataContext.ReviewResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="12,5"
                                                            Margin="0,0,5,0"
                                                            Background="#0f766e"
                                                            Foreground="White"
                                                            BorderThickness="0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="8"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    <Button Content="Descartar"
                                                            Command="{Binding DataContext.DiscardResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,5"
                                                            Margin="0,0,5,0"
                                                            Background="#450a0a"
                                                            Foreground="#fca5a5"
                                                            BorderThickness="0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="8"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    <Button Content="Guardar"
                                                            Command="{Binding DataContext.SaveToDbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="15,5"
                                                            Background="{StaticResource PrimaryBrush}"
                                                            Foreground="White"
                                                            BorderThickness="0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius"
                                                                        Value="8"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModernCard}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                        Command="{Binding DataContext.ToggleFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="50"
                                                        Height="50"
                                                        CornerRadius="12"
                                                        Background="#1e293b"
                                                        Margin="0,0,20,0">
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Padding="0"/>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                            FontSize="16"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"/>
                                                    <TextBlock Text="Documento pendiente de analizar"
                                                            FontSize="11"
                                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Padding="10,5"
                                                        CornerRadius="5"
                                                        Background="#1e293b">
                                                    <TextBlock Text="Procesando..."
                                                            FontSize="10"
                                                            Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Odoo">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               LastChildFill="False"
                               Margin="0,0,0,24">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Odoo"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Selecciona una orden guardada en SQL y crea el presupuesto correspondiente en Odoo."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       MaxWidth="680"/>
                        </StackPanel>

                        <Button Content="Actualizar órdenes"
                                Command="{Binding CargarOrdenesOdooCommand}"
                                Style="{StaticResource SecondaryButton}"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Top"/>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Style="{StaticResource ModernCard}"
                            Padding="0"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="20,16"
                                    BorderBrush="#1e293b"
                                    BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Órdenes disponibles"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding OrdenesOdoo.Count, StringFormat={}{0} registros}"
                                               DockPanel.Dock="Right"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"/>
                                </DockPanel>
                            </Border>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding OrdenesOdoo}"
                                     SelectedItem="{Binding OrdenOdooSeleccionada, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,10"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="#111827"
                                                            BorderBrush="#1f2937"
                                                            BorderThickness="1"
                                                            CornerRadius="14"
                                                            Padding="18">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1e1b4b"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#475569"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Numero}"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ClienteNombre}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TotalTexto}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0">
                                                    <Run Text="{Binding FechaTexto, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Lineas, Mode=OneWay}"/>
                                                    <Run Text=" líneas"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource CardBgBrush}"
                            BorderBrush="#1e293b"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="18">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Orden seleccionada"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OrdenOdooSeleccionada.Numero, TargetNullValue=Ninguna orden seleccionada}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button Content="CREAR PRESUPUESTO EN ODOO"
                                    Command="{Binding CrearPresupuestoEnOdooCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            
            <TabItem Header="Configuración">
                <Grid Margin="0,20,0,0">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Mantenimiento" 
                                 FontSize="24" 
                                 FontWeight="Bold" 
                                 Foreground="White" 
                                 Margin="0,0,0,10"/>
                        <TextBlock Text="Gestiona el almacenamiento y el historial de la aplicación." 
                                 Foreground="{StaticResource TextSecondaryBrush}" 
                                 Margin="0,0,0,30"/>

                        <Border Style="{StaticResource ModernCard}" Padding="30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Borrar Historial de Procesados" 
                                             FontSize="16" 
                                             FontWeight="Bold" 
                                             Foreground="White" 
                                             Margin="0,0,0,5"/>
                                    <TextBlock Text="Elimina permanentemente todos los archivos procesados y los datos acumulados." 
                                             FontSize="12" 
                                             Foreground="{StaticResource TextSecondaryBrush}" 
                                             TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                        Content="BORRAR HISTORIAL" 
                                        Command="{Binding ClearHistoryCommand}"
                                        Background="#450a0a"
                                        Foreground="#fca5a5"
                                        Padding="20,10"
                                        FontWeight="Bold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Background="{StaticResource CardBgBrush}"
                CornerRadius="16"
                Padding="20,10"
                Margin="40,0,40,20">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        VerticalAlignment="Center"/>
                <ProgressBar IsIndeterminate="{Binding IsBusy}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             DockPanel.Dock="Right"
                        Width="150"
                        Height="4"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.RowSpan="2" 
              Panel.ZIndex="1000"
              Background="#CC020617"
              Visibility="{Binding IsValidationPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            
            <Border Style="{StaticResource ModernCard}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="850"
                    MaxHeight="650"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1"
                    Background="{StaticResource BgDarkBrush}"
                    Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Validación de Datos Extraídos" 
                                   Foreground="White" 
                                   FontSize="24" 
                                   FontWeight="Bold"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="DATOS DEL CLIENTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="Nombre" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CurrentOrderReview.Cliente.Nombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                    <TextBlock Text="NIF / IVA" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CurrentOrderReview.Cliente.NifIva, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Dirección" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CurrentOrderReview.Cliente.Direccion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="DATOS DEL PEDIDO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Nº Orden" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CurrentOrderReview.Orden.Numero, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Fecha" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CurrentOrderReview.Orden.Fecha, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Total TTC" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding CurrentOrderReview.Totales.TotalTTC, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentOrderReview.Totales.Moneda}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="LÍNEAS DEL PEDIDO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                                <DataGrid ItemsSource="{Binding CurrentOrderReview.Lineas}" 
                                          AutoGenerateColumns="False" 
                                          Background="Transparent" 
                                          BorderThickness="0"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          Foreground="White"
                                          RowHeight="40">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1e293b"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#334155"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoProducto, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding ImporteHT, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Descartar" 
                                Command="{Binding CancelReviewCommand}"
                                Margin="0,0,15,0"
                                Width="120"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="#334155"
                                BorderThickness="1">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="CONFIRMAR Y GUARDAR" 
                                Command="{Binding SaveReviewedToDbCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="200"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
